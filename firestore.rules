rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Cuenta admin (moderación: borrar publicaciones, otorgar verificado).
    // Cambiá este email si alguna vez cambiás de cuenta admin.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'reyesblas200910@gmail.com';
    }

    // Perfiles: cualquier usuario logueado puede leerlos (foto, bio, instrumento
    // principal). Cada persona edita el suyo, pero no puede tocar sus propios
    // campos "verified" ni "isOwner" — esos solo los puede escribir la cuenta
    // admin (incluso sobre su propio perfil).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'isOwner']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'isOwner']))
      );
      allow delete: if false;
    }

    // Instrumentos publicados: lectura pública para usuarios logueados.
    // Solo el dueño puede crear su publicación. Cualquier usuario logueado
    // puede "likear", pero la regla solo permite tocar el contador de likes
    // (de a 1 por vez) — no puede modificar el resto del documento.
    // El borrado lo puede hacer el dueño de la publicación o la cuenta admin.
    match /instruments/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.likesCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        && (request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1);
      allow delete: if signedIn() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Bandas: cualquier usuario logueado puede crear la suya y editarla
    // (integrantes, redes, próximas fechas). Borrado: dueño o admin.
    match /bands/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId;
      allow delete: if signedIn() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Chats 1 a 1: solo los dos participantes pueden leer/escribir la
    // conversación y sus mensajes.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
